{
  "layout:falconherd": {
    "alt-down": "falcon-sidebar.next",
    "alt-up": "falcon-sidebar.prev",
    "ctrl-shift-pagedown": "falcon-sidebar.next",
    "ctrl-shift-pageup": "falcon-sidebar.prev",
    "ctrl-space shift-n": "falcon-sidebar.next",
    "ctrl-space shift-p": "falcon-sidebar.prev",
    "ctrl-shift-g": "falcon-status.usage",
    "ctrl-shift-s": "falcon-header.side",
    "ctrl-shift-d": "falcon-header.fork",
    "ctrl-shift-m": "falcon-header.send",
    "ctrl-space r": "falcon-tabs.regenerate",
    "ctrl-space a": "falcon-agents.attention",
    "ctrl-space s": "tab.settle",
    "ctrl-space z": "falcon-agents.snooze",
    "ctrl-space u": "falcon-agents.reopen",
    "ctrl-space l": "falcon-tabs.last",
    "alt-shift-left": "falcon-tabs.move-left",
    "alt-shift-right": "falcon-tabs.move-right",
    "shift-pageup": {
      "command": "terminal.scroll",
      "args": {
        "pages": -1
      }
    },
    "shift-pagedown": {
      "command": "terminal.scroll",
      "args": {
        "pages": 1
      }
    },
    "shift-home": {
      "command": "terminal.scroll",
      "args": {
        "to": "top"
      }
    },
    "shift-end": {
      "command": "terminal.scroll",
      "args": {
        "to": "bottom"
      }
    },
    "ctrl-shift-j": {
      "command": "layout.toggle",
      "args": {
        "id": "panel"
      }
    },
    "ctrl-space f": "falcon-tabs.files",
    "ctrl-space c": "falcon-tabs.changes",
    "ctrl-space b": "falcon-header.subagents",
    "ctrl-space w": "falcon-header.switch",
    "ctrl-space p": "falcon-agents.pin",
    "f11": "window.maximize"
  }
}
