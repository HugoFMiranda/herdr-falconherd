#!/usr/bin/env python3
"""claude-subagent-md <agent-ID.jsonl> <out.md>: a readable summary of one Claude Code sub-agent
(its task, status and latest output), for the md-view window. Read only on the transcript."""
import json, os, sys

def text_of(content):
    if isinstance(content, str): return content
    if isinstance(content, list):
        return "\n\n".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text").strip()
    return ""

def main(src, out):
    meta = {}
    try: meta = json.load(open(src[:-len(".jsonl")] + ".meta.json", encoding="utf-8"))
    except Exception: pass
    task, latest, tools = "", "", 0
    for line in open(src, encoding="utf-8", errors="replace"):
        try: d = json.loads(line)
        except Exception: continue
        msg = d.get("message") or {}
        content = msg.get("content")
        if d.get("type") == "user" and not task: task = text_of(content)
        if d.get("type") == "assistant":
            t = text_of(content)
            if t: latest = t
            if isinstance(content, list): tools += sum(1 for c in content if isinstance(c, dict) and c.get("type") == "tool_use")
    status = "finished" if meta.get("finished") else "running"
    head = " · ".join(x for x in [meta.get("agentType"), meta.get("model"), status] if x)
    md = f"# {meta.get('description') or 'Sub-agent'}\n\n{head} · {tools} tool call{'s' if tools != 1 else ''}\n\n"
    md += f"## Latest output\n\n{latest or '_Nothing yet._'}\n\n## Task\n\n{task or '_Unknown._'}\n"
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    with open(out + ".tmp", "w", encoding="utf-8") as fh: fh.write(md)
    os.replace(out + ".tmp", out)

if __name__ == "__main__":
    if len(sys.argv) != 3: sys.exit("usage: claude-subagent-md <agent.jsonl> <out.md>")
    main(sys.argv[1], sys.argv[2])
